# Backend env template — safe to commit. Copy to .env only to override a default;
# the tool runs without one. Client AFAS credentials do NOT go here: they are per
# project, in json_files/client_tokens.json (gitignored), filled in from the app.

# Who the local user is — shown in the sidebar and written as "checked by".
#LOCAL_USER_EMAIL=lokaal@localhost
#LOCAL_USER_NAME=Lokaal

# The frontend's origin, for CORS on a direct call (normally Next proxies /api).
#FRONTEND_URL=http://localhost:3010

# How long a client's UpdateConnector schema is cached, in seconds.
#AFAS_SCHEMA_CACHE_TTL=3600

# Move the whole json_files/ folder elsewhere.
#JSON_DIR=
