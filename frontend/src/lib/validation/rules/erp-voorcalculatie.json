{
  "columns": [
    {
      "column": "Projectnummer",
      "type": "text",
      "rules": [
        { "check": "required" },
        {
          "check": "regex",
          "pattern": "^[A-Za-z0-9]+$",
          "message": "Mag geen spaties of speciale tekens bevatten",
          "messageEn": "Must not contain spaces or special characters"
        },
        { "check": "length", "max": 15 },
        { "check": "same-in-group", "groupColumn": "Offerte" }
      ]
    },
    {
      "column": "Offerte",
      "type": "text",
      "rules": [{ "check": "required" }, { "check": "length", "max": 21 }]
    },
    {
      "column": "Begindatum Offerte",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": [
        { "check": "required" },
        { "check": "same-in-group", "groupColumn": "Offerte" }
      ]
    },
    {
      "column": "Einddatum Offerte",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": [{ "check": "same-in-group", "groupColumn": "Offerte" }]
    },
    {
      "column": "Begindatum Regel",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": [{ "check": "required" }]
    },
    {
      "column": "Einddatum Regel",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": []
    },
    {
      "column": "Type item",
      "type": "text",
      "rules": [
        { "check": "required" },
        {
          "check": "enum",
          "values": ["Art", "Kst", "Sam", "Wst"],
          "message": "Moet Art (Artikel), Kst (Kosten), Sam (Samenstelling) of Wst (Werksoort) zijn",
          "messageEn": "Must be Art (item), Kst (costs), Sam (composition) or Wst (work type)"
        }
      ]
    },
    {
      "column": "Itemcode",
      "type": "text",
      "rules": [
        { "check": "required" },
        {
          "check": "codetabel",
          "tableRef": "Items",
          "message": "Onbekende itemcode",
          "messageEn": "Unknown item code"
        }
      ]
    },
    {
      "column": "APPREO Facturatie",
      "type": "text",
      "rules": []
    },
    {
      "column": "APPREO Frequentie Uitvoer",
      "type": "text",
      "rules": []
    },
    {
      "column": "APPREO Planuren",
      "type": "decimal",
      "rules": [{ "check": "min", "value": 0 }]
    },
    {
      "column": "APPREO OE",
      "type": "text",
      "rules": []
    },
    {
      "column": "APPREO Afwijkende Factuurtekst",
      "type": "text",
      "rules": [{ "check": "length", "max": 255 }]
    },
    {
      "column": "APPREO Werkinstructies",
      "type": "text",
      "rules": []
    },
    {
      "column": "APPREO Afwijkende Prijs",
      "type": "decimal",
      "rules": [{ "check": "min", "value": 0 }]
    },
    {
      "column": "APPREO Werksoort",
      "type": "text",
      "rules": [{ "check": "length", "max": 40 }]
    },
    {
      "column": "APPREO Onderaannemer",
      "type": "text",
      "rules": [{ "check": "length", "max": 16 }]
    }
  ],
  "crossField": [
    {
      "if": { "column": "Begindatum Offerte", "op": "isNotEmpty" },
      "then": {
        "column": "Einddatum Offerte",
        "op": ">=",
        "value": { "column": "Begindatum Offerte" }
      },
      "message": "Moet gelijk aan of later dan Begindatum Offerte zijn",
      "messageEn": "Must be the same as or later than Begindatum Offerte"
    },
    {
      "if": { "column": "Begindatum Offerte", "op": "isNotEmpty" },
      "then": {
        "column": "Begindatum Regel",
        "op": ">=",
        "value": { "column": "Begindatum Offerte" }
      },
      "message": "Mag niet eerder liggen dan Begindatum Offerte",
      "messageEn": "Must not be earlier than Begindatum Offerte"
    },
    {
      "if": { "column": "Einddatum Offerte", "op": "isNotEmpty" },
      "then": {
        "column": "Einddatum Regel",
        "op": "<=",
        "value": { "column": "Einddatum Offerte" }
      },
      "message": "Mag niet later liggen dan Einddatum Offerte",
      "messageEn": "Must not be later than Einddatum Offerte"
    },
    {
      "if": { "column": "Begindatum Regel", "op": "isNotEmpty" },
      "then": {
        "column": "Einddatum Regel",
        "op": ">=",
        "value": { "column": "Begindatum Regel" }
      },
      "message": "Moet gelijk aan of later dan Begindatum Regel zijn",
      "messageEn": "Must be the same as or later than Begindatum Regel"
    }
  ]
}
