  "crossField": [
    {
      "if": {
        "column": "Geboortenaam apart vastleggen",
        "op": "==",
        "value": "J"
      },
      "then": {
        "column": "Geboortenaam",
        "op": "isNotEmpty"
      },
      "message": "Verplicht als 'Geboortenaam apart vastleggen' = J",
      "messageEn": "Required when 'Geboortenaam apart vastleggen' = J"
    },
    {
      "if": {
        "column": "Type contract",
        "op": "==",
        "value": "B"
      },
      "then": {
        "column": "Einddatum contract",
        "op": "isNotEmpty"
      },
      "message": "Verplicht bij type contract = B (bepaalde tijd)",
      "messageEn": "Required when type contract = B (fixed term)"
    },
    {
      "if": {
        "column": "Type contract",
        "op": "==",
        "value": "O"
      },
      "then": {
        "column": "Ketennummer",
        "op": "<=",
        "value": "0"
      },
      "message": "Moet 0 (niet van toepassing) zijn bij type contract = O (onbepaalde tijd)",
      "messageEn": "Must be 0 (not applicable) when type contract = O (permanent)"
    },
    {
      "if": {
        "column": "Soort salaris",
        "op": "==",
        "value": "Su"
      },
      "then": {
        "column": "Soort loonschaal",
        "op": "isNotEmpty"
      },
      "message": "Verplicht bij schaaluurloon (Soort salaris = Su)",
      "messageEn": "Required for scale hourly wage (Soort salaris = Su)"
    },
    {
      "if": {
        "column": "Soort salaris",
        "op": "==",
        "value": "Su"
      },
      "then": {
        "column": "Loonschaal",
        "op": "isNotEmpty"
