{
  "columns": [
    {
      "column": "Type dossieritem",
      "type": "integer",
      "rules": [
        { "check": "required" },
        { "check": "min", "value": 1 }
      ]
    },
    {
      "column": "Onderwerp",
      "type": "text",
      "rules": [
        { "check": "required" },
        { "check": "length", "max": 255 }
      ]
    },
    {
      "column": "Toelichting",
      "type": "text",
      "rules": []
    },
    {
      "column": "Instuurdatum",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": [{ "check": "required" }]
    },
    {
      "column": "Instuurder",
      "type": "text",
      "rules": [{ "check": "length", "max": 80 }]
    },
    {
      "column": "Verantwoordelijke",
      "type": "text",
      "rules": [{ "check": "length", "max": 80 }]
    },
    {
      "column": "Prioriteit",
      "type": "text",
      "rules": [
        {
          "check": "enum",
          "values": ["H", "N", "L"],
          "message": "Moet H (Hoog), N (Normaal) of L (Laag) zijn",
          "messageEn": "Must be H (high), N (normal) or L (low)"
        }
      ]
    },
    {
      "column": "Begindatum",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": []
    },
    {
      "column": "Einddatum",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": []
    },
    {
      "column": "Afgehandeld",
      "type": "text",
      "rules": [
        {
          "check": "enum",
          "values": ["Ja", "Nee"],
          "message": "Moet Ja of Nee zijn",
          "messageEn": "Must be Ja or Nee"
        }
      ]
    },
    {
      "column": "Datum afgehandeld",
      "type": "date",
      "format": "DD-MM-YYYY | DD/MM/YYYY",
      "rules": []
    },
    {
      "column": "Type bestemming",
      "type": "text",
      "rules": [
        { "check": "required" },
        {
          "check": "enum",
          "values": ["1", "2", "3", "4", "8", "9", "10", "11", "17", "66"],
          "message": "Moet een geldige bestemmingscode zijn — 1 (Geen), 2 (Medewerker), 3 (Organisatie/persoon), 4 (Verkooprelatie), 8, 9, 10, 11, 17 of 66",
          "messageEn": "Must be a valid destination code — 1 (None), 2 (Employee), 3 (Organisation/person), 4 (Sales relation), 8, 9, 10, 11, 17 or 66"
        }
      ]
    },
    {
      "column": "Bestemming",
      "type": "text",
      "rules": [{ "check": "length", "max": 50 }]
    },
    {
      "column": "Organisatie of persoon",
      "type": "text",
      "rules": [{ "check": "length", "max": 15 }]
    },
    {
      "column": "Medewerker",
      "type": "text",
      "rules": [{ "check": "length", "max": 15 }]
    },
    {
      "column": "Projectnummer",
      "type": "text",
      "rules": [{ "check": "length", "max": 15 }]
    },
    {
      "column": "Contractnummer",
      "type": "text",
      "rules": [{ "check": "length", "max": 16 }]
    },
    {
      "column": "Organisatorische eenheid",
      "type": "text",
      "rules": [
        { "check": "length", "max": 10 },
        {
          "check": "codetabel",
          "tableRef": "Organisatie-eenheden",
          "message": "Onbekende organisatorische eenheid",
          "messageEn": "Unknown organisational unit"
        }
      ]
    },
    {
      "column": "Geblokkeerd",
      "type": "text",
      "rules": [
        {
          "check": "enum",
          "values": ["Ja", "Nee"],
          "message": "Moet Ja of Nee zijn",
          "messageEn": "Must be Ja or Nee"
        }
      ]
    },
    {
      "column": "Bestandsnaam bijlage",
      "type": "text",
      "rules": [{ "check": "length", "max": 255 }]
    }
  ],
  "crossField": [
    {
      "if": { "column": "Begindatum", "op": "isNotEmpty" },
      "then": {
        "column": "Einddatum",
        "op": ">=",
        "value": { "column": "Begindatum" }
      },
      "message": "Moet gelijk aan of later dan Begindatum zijn",
      "messageEn": "Must be the same as or later than Begindatum"
    },
    {
      "if": { "column": "Afgehandeld", "op": "==", "value": "Ja" },
      "then": { "column": "Datum afgehandeld", "op": "isNotEmpty" },
      "message": "Bij een afgehandeld dossieritem is de datum van afhandeling verplicht",
      "messageEn": "For a completed dossier item the completion date is required"
    },
    {
      "if": { "column": "Afgehandeld", "op": "==", "value": "Nee" },
      "then": { "column": "Datum afgehandeld", "op": "isEmpty" },
      "message": "Een dossieritem dat niet is afgehandeld heeft geen datum van afhandeling",
      "messageEn": "A dossier item that is not completed has no completion date"
    },
    {
      "if": { "column": "Type bestemming", "op": "==", "value": "2" },
      "then": { "column": "Medewerker", "op": "isNotEmpty" },
      "message": "Bij bestemming Medewerker is de medewerker verplicht",
      "messageEn": "For destination Medewerker the employee is required"
    },
    {
      "if": { "column": "Type bestemming", "op": "==", "value": "3" },
      "then": { "column": "Organisatie of persoon", "op": "isNotEmpty" },
      "message": "Bij bestemming Organisatie/persoon is de organisatie of persoon verplicht",
      "messageEn": "For destination Organisatie/persoon the organisation or person is required"
    },
    {
      "if": { "column": "Instuurdatum", "op": "isNotEmpty" },
      "then": {
        "column": "Datum afgehandeld",
        "op": ">=",
        "value": { "column": "Instuurdatum" }
      },
      "message": "Mag niet eerder liggen dan de instuurdatum",
      "messageEn": "Must not be earlier than the submission date"
    }
  ]
}
